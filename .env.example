DASHSCOPE_API_KEY=sk-xxx
LLM_MODEL=qwen-plus

# 本机代理（只给网页检索用；LLM 默认直连，避免代理挂掉连带模型调用失败）
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890

# LLM 也走代理时设 1（一般不需要）
# LLM_USE_PROXY=0

# 断言核验（默认开启，最多 20 句；想省钱可关掉或换便宜模型）
# CLAIM_VERIFY_ENABLED=1
# CLAIM_VERIFY_STRICT=0
# CLAIM_VERIFY_MAX_CLAIMS=20
# LLM_VERIFY_MODEL=qwen-plus

# checkpoint 保留最近多少个 thread（0=不清理）
# CHECKPOINT_KEEP_THREADS=20

# 运行历史目录
# RUNS_DIR=runs

# 填了单价才输出成本估算（元/百万 token）
# LLM_PRICE_INPUT_PER_M=0
# LLM_PRICE_OUTPUT_PER_M=0